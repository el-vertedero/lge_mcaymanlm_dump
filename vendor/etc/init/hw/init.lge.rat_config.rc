# LGP_MODEMBSP_RAT_CONFIG - Start

on property:ro.boot.vendor.lge.wm_id=25
    setprop ro.vendor.mtk_ps1_rat N/C/Lf/Lt/W/G
    setprop ro.vendor.mtk_protocol1_rat_config N/C/Lf/Lt/W/G
    setprop ro.vendor.mtk_eccci_c2k 1
    setprop ro.vendor.mtk_c2k_support 1
    setprop ro.vendor.mtk_lte_support 1
    setprop ro.vendor.mtk_md1_support 25
    setprop ro.vendor.mtk_c2k_lte_mode 2
    setprop ro.vendor.mtk_md3_support 0

